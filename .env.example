# =============================================================================
# Environment Server Cloudflare & Dev Lokal (JANGAN gunakan prefix VITE_)
# Semua nilai di bawah hanya berjalan di sisi server (Cloudflare Worker / Pages Function)
# dan tidak pernah dikirim ke JavaScript browser pengunjung.
# =============================================================================

# URL Project Supabase (Dashboard -> Project Settings -> Data API / API)
SUPABASE_URL=

# Service Role Key Supabase (sb_secret_... atau legacy service_role JWT)
# Dipakai server untuk verifikasi login tabel profiles dan CRUD database.
SUPABASE_SERVICE_ROLE_KEY=

# Publishable Key Supabase (sb_publishable_... atau anon key) - opsional untuk endpoint publik
SUPABASE_PUBLISHABLE_KEY=

# Secret acak minimal 32 karakter untuk menandatangani cookie sesi admin (opsional, disarankan isi)
SESSION_SECRET=

# Opsional: domain publik custom R2 (misal https://media.niwayuliana.com) jika tidak ingin lewat /api/media/public/...
# Saat kosong, gambar publik otomatis dilayani lewat endpoint /api/media/public/... dari binding R2 MEDIA_BUCKET.
# Di lokal (npm run dev), upload otomatis masuk ke folder .local-r2/ (tidak masuk ke R2 produksi).
R2_PUBLIC_URL=

# =============================================================================
# Environment Frontend Publik (aman dikirim ke browser)
# =============================================================================

# Access Key dari https://web3forms.com/ untuk section form Saran & Masukan (#masukan)
VITE_WEB3FORMS_ACCESS_KEY=
